DATABASE_URL=jdbc:postgresql://localhost:5432/nidio
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=change-me
JWT_EXPIRATION_MS=86400000
ML_SERVICE_URL=http://localhost:8000

# Cifrado de "Mis lugares" (Life Score): direcciones/lat/lon personales del
# usuario, AES-256-GCM. Generarla con `openssl rand -base64 32` (32 bytes en
# base64) y ponerla acá en el .env real y también en las variables de entorno
# de Render — nunca commitear la clave real, este archivo es solo la
# plantilla. Sin esta variable el backend no arranca (a propósito).
CUSTOM_PLACE_ENCRYPTION_KEY=

# Email (HU-03: recuperación de contraseña; verificación de email al
# registrarse). Gmail SMTP con la cuenta nidio.propiedades@gmail.com +
# "contraseña de aplicación" (App Password), ver instrucciones en el .env
# local (este archivo es solo la plantilla, no pongas credenciales reales
# acá).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=nidio.propiedades@gmail.com
MAIL_PASSWORD=
MAIL_FROM=nidio.propiedades@gmail.com
PASSWORD_RESET_URL_BASE=http://localhost:5173/auth/restablecer
EMAIL_VERIFICATION_URL_BASE=http://localhost:5173/auth/verificar

# Fotos subidas desde "Publicar": Cloudinary (plan gratuito), ver
# instrucciones en el .env local (este archivo es solo la plantilla, no
# pongas credenciales reales acá).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
